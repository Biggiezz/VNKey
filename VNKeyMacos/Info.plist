<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- ══════════════════════════════════════════════════════════════
         BUNDLE IDENTIFICATION
         Bundle Identifier PHẢI chứa "inputmethod" để macOS nhận diện.
         ══════════════════════════════════════════════════════════════ -->
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>

    <key>CFBundleName</key>
    <string>VNKey</string>

    <key>CFBundleDisplayName</key>
    <string>VNKey - Vietnamese Input</string>

    <key>CFBundleVersion</key>
    <string>1.0.0</string>

    <key>CFBundleShortVersionString</key>
    <string>1.0</string>

    <key>CFBundlePackageType</key>
    <string>APPL</string>

    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>

    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>

    <key>NSHumanReadableCopyright</key>
    <string>Copyright © 2026 VNKey. All rights reserved.</string>

    <!-- ══════════════════════════════════════════════════════════════
         APPLICATION BEHAVIOR
         ══════════════════════════════════════════════════════════════ -->

    <!-- Không hiện trong Dock hay App Switcher (Cmd+Tab), chỉ chạy trên Menu Bar -->
    <key>LSUIElement</key>
    <true/>

    <!-- Minimum macOS version -->
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>

    <key>CFBundleIconFile</key>
    <string>AppIcon</string>

    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
</dict>
</plist>
